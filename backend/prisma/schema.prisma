generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ATTENDANT
  ADMIN
}

enum UserPermission {
  ACCESS_DASHBOARD
  ACCESS_TICKETS
  ACCESS_ASSETS
  MANAGE_ASSETS
  DISCOVER_ASSETS
  ACCESS_ACCESSORIES
  MANAGE_ACCESSORIES
  ACCESS_REPORTS
  ACCESS_COMPANIES
  MANAGE_COMPANIES
  ACCESS_SUPPLIERS
  MANAGE_SUPPLIERS
  ACCESS_USERS
  MANAGE_USERS
  ACCESS_LICENSES
  MANAGE_LICENSES
  ACCESS_IP_ADDRESSES
  MANAGE_IP_ADDRESSES
  ACCESS_PASSWORD_VAULT
  MANAGE_PASSWORD_VAULT
}

enum TicketStatus {
  OPEN
  IN_ANALYSIS
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TicketCategory {
  TI
  MANUTENCAO_INDUSTRIAL
  DIRETORIA
  EXPEDICAO
  ENGENHARIA_DE_MINAS
  RECEPCAO
  PORTARIA
  RECURSOS_HUMANOS
  COMERCIAL
  SELECAO_E_RECRUTAMENTO
  MANUTENCAO_DE_AUTO
  RH
  FINANCEIRO
  COMPRAS
  INFRAESTRUTURA
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  WARRANTY
  DONOR
  RETIRED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
}

enum AssetHistoryAction {
  CREATED
  UPDATED
  ASSIGNED
  RETURNED
  STATUS_CHANGED
  DONOR
  RETIRED
}

enum AccessoryMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum AssetType {
  DESKTOP
  NOTEBOOK
  SERVER
  VIRTUAL_MACHINE
  MONITOR
  MOUSE
  KEYBOARD
  PRINTER
  MOBILE
  TABLET
  IP_PHONE
  VOIP_SERVER
  CAMERA
  DVR_NVR
  ROUTER
  SWITCH
  ACCESS_POINT
  ANTENNA
  TIME_CLOCK
  TURNSTILE
  FIREWALL
  UPS
  OTHER
}

enum DiscoveryIgnoreMode {
  NETWORK
  PRINTER
  WINDOWS
}

enum CustodyTermType {
  DELIVERY
  RETURN
}

enum CustodyTermStatus {
  DRAFT
  SIGNED
  CANCELLED
}

enum MaintenanceRecordStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PurchaseRequestStatus {
  REQUESTED
  QUOTING
  APPROVED
  ORDERED
  RECEIVED
  CANCELLED
}

model User {
  id                       String    @id @default(uuid())
  name                     String
  username                 String?   @unique
  email                    String    @unique
  passwordHash             String    @map("password_hash")
  role                     UserRole  @default(USER)
  active                   Boolean   @default(true)
  mustChangePassword       Boolean   @default(false) @map("must_change_password")
  passwordResetRequestedAt DateTime? @map("password_reset_requested_at")
  passwordResetHandledAt   DateTime? @map("password_reset_handled_at")
  avatarUrl                String?   @map("avatar_url")
  themePreference          String?   @map("theme_preference")
  appearanceMode           String    @default("LIGHT") @map("appearance_mode")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  companyId                String?   @map("company_id")

  // Relações
  ticketsCreated              Ticket[]                           @relation("TicketCreator")
  ticketsAssigned             Ticket[]                           @relation("TicketAssignee")
  comments                    Comment[]
  historyChanges              TicketHistory[]
  feedbacks                   Feedback[]
  chatMessages                ChatMessage[]
  assetsAssigned              Asset[]                            @relation("AssetAssignee")
  assetHistory                AssetHistory[]
  accessoryMovementsPerformed AccessoryMovement[]                @relation("AccessoryMovementPerformer")
  accessoryMovementsReceived  AccessoryMovement[]                @relation("AccessoryMovementUser")
  accessoryMovementsCanceled  AccessoryMovement[]                @relation("AccessoryMovementCanceller")
  disposalItems               DisposalItem[]                     @relation("DisposalPerformer")
  company                     Company?                           @relation(fields: [companyId], references: [id])
  permissions                 UserPermissionGrant[]
  passwordVaultEntries        PasswordVaultEntry[]
  auditLogs                   AuditLog[]
  discoveryIgnoredIps         DiscoveryIgnoredIp[]
  remoteDiscoveryJobs         RemoteDiscoveryJob[]
  custodyTermsResponsible     CustodyTerm[]                      @relation("CustodyTermResponsible")
  custodyTermsCreated         CustodyTerm[]                      @relation("CustodyTermCreator")
  maintenanceRecordsCreated   MaintenanceRecord[]                @relation("MaintenanceCreator")
  maintenanceRecordsCompleted MaintenanceRecord[]                @relation("MaintenanceCompleter")
  knowledgeArticles           KnowledgeArticle[]
  purchaseRequests            PurchaseRequest[]
  licenseAssignmentHistory    SoftwareLicenseAssignmentHistory[] @relation("LicenseHistoryPerformer")

  @@index([passwordResetRequestedAt])
  @@map("users")
}

model RemoteDiscoveryJob {
  id          String    @id @default(uuid())
  siteName    String    @map("site_name")
  prefix      String
  firstIp     Int       @map("first_ip")
  lastIp      Int       @map("last_ip")
  status      String    @default("PENDING")
  agentName   String?   @map("agent_name")
  agentInfo   Json?     @map("agent_info")
  results     Json?
  error       String?   @db.Text
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  claimedAt   DateTime? @map("claimed_at")
  completedAt DateTime? @map("completed_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([status, createdAt])
  @@map("remote_discovery_jobs")
}

model RemoteDiscoveryAgent {
  id           String   @id @default(uuid())
  agentName    String   @map("agent_name")
  computerName String   @map("computer_name")
  agentInfo    Json     @map("agent_info")
  firstSeenAt  DateTime @default(now()) @map("first_seen_at")
  lastSeenAt   DateTime @updatedAt @map("last_seen_at")

  @@unique([agentName, computerName])
  @@index([lastSeenAt])
  @@map("remote_discovery_agents")
}

model UserPermissionGrant {
  id         String         @id @default(uuid())
  userId     String         @map("user_id")
  permission UserPermission
  createdAt  DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([permission])
  @@map("user_permission_grants")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  legalName String?  @map("legal_name")
  code      String   @unique
  taxId     String?  @unique @map("tax_id")
  email     String?
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assets               Asset[]                 @relation("AssetCompany")
  purchasedAssets      Asset[]                 @relation("AssetPurchasedByCompany")
  users                User[]
  softwareLicenses     SoftwareLicense[]
  accessories          Accessory[]             @relation("AccessoryCompany")
  purchasedAccessories Accessory[]             @relation("AccessoryPurchasedByCompany")
  networkSegments      NetworkSegment[]
  accessoryBalances    AccessoryStockBalance[]

  @@map("companies")
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  legalName   String?  @map("legal_name")
  taxId       String?  @unique @map("tax_id")
  email       String?
  phone       String?
  contactName String?  @map("contact_name")
  category    String?
  website     String?
  address     String?
  notes       String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assets           Asset[]
  accessories      Accessory[]
  softwareLicenses SoftwareLicense[]
  purchaseRequests PurchaseRequest[]

  @@index([name])
  @@index([active])
  @@map("suppliers")
}

model Asset {
  id                       String         @id @default(uuid())
  assetTag                 String         @unique @map("asset_tag")
  name                     String
  category                 String
  type                     AssetType      @default(OTHER)
  manufacturer             String?
  model                    String?
  serialNumber             String?        @unique @map("serial_number")
  bandFrequency            String?        @map("band_frequency")
  firmware                 String?
  status                   AssetStatus    @default(AVAILABLE)
  condition                AssetCondition @default(GOOD)
  location                 String?
  assignedToId             String?        @map("assigned_to_id")
  parentAssetId            String?        @map("parent_asset_id")
  companyId                String?        @map("company_id")
  ipAddress                String?        @map("ip_address")
  networkSegmentId         String?        @map("network_segment_id")
  gateway                  String?
  macAddress               String?        @unique @map("mac_address")
  hostname                 String?
  operatingSystem          String?        @map("operating_system")
  osVersion                String?        @map("os_version")
  osArchitecture           String?        @map("os_architecture")
  processor                String?
  cpuCores                 Int?           @map("cpu_cores")
  cpuLogicalProcessors     Int?           @map("cpu_logical_processors")
  memoryMb                 Int?           @map("memory_mb")
  diskGb                   Int?           @map("disk_gb")
  diskFreeGb               Int?           @map("disk_free_gb")
  loggedUser               String?        @map("logged_user")
  domain                   String?
  workgroup                String?
  systemType               String?        @map("system_type")
  biosVersion              String?        @map("bios_version")
  biosReleaseDate          DateTime?      @map("bios_release_date") @db.Date
  windowsInstallDate       DateTime?      @map("windows_install_date")
  lastFormattedAt          DateTime?      @map("last_formatted_at")
  lastBootAt               DateTime?      @map("last_boot_at")
  windowsLicenseKey        String?        @map("windows_license_key")
  windowsLicenseStatus     String?        @map("windows_license_status")
  windowsProductKeyPartial String?        @map("windows_product_key_partial")
  lastSeenAt               DateTime?      @map("last_seen_at")
  discoverySource          String?        @map("discovery_source")
  openPorts                Int[]          @default([]) @map("open_ports")
  communicationPort        Int?           @map("communication_port")
  deviceIdentifier         String?        @map("device_identifier")
  accessDirection          String?        @map("access_direction")
  readerTechnology         String?        @map("reader_technology")
  capacityUsers            Int?           @map("capacity_users")
  ntpServer                String?        @map("ntp_server")
  purchaseDate             DateTime?      @map("purchase_date") @db.Date
  warrantyExpires          DateTime?      @map("warranty_expires") @db.Date
  maintenanceIntervalDays  Int?           @map("maintenance_interval_days")
  nextMaintenanceAt        DateTime?      @map("next_maintenance_at") @db.Date
  purchaseCost             Decimal?       @map("purchase_cost") @db.Decimal(12, 2)
  purchasedByCompanyId     String?        @map("purchased_by_company_id")
  supplierId               String?        @map("supplier_id")
  purchaseSupplier         String?        @map("purchase_supplier")
  purchaseInvoiceNumber    String?        @map("purchase_invoice_number")
  purchaseInvoiceAccessKey String?        @map("purchase_invoice_access_key")
  notes                    String?        @db.Text
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")

  assignedTo           User?                              @relation("AssetAssignee", fields: [assignedToId], references: [id])
  parentAsset          Asset?                             @relation("AssetPeripherals", fields: [parentAssetId], references: [id], onDelete: SetNull)
  peripherals          Asset[]                            @relation("AssetPeripherals")
  company              Company?                           @relation("AssetCompany", fields: [companyId], references: [id])
  purchasedByCompany   Company?                           @relation("AssetPurchasedByCompany", fields: [purchasedByCompanyId], references: [id])
  supplier             Supplier?                          @relation(fields: [supplierId], references: [id])
  history              AssetHistory[]
  accessoryMovements   AccessoryMovement[]
  softwareLicenses     SoftwareLicenseAsset[]
  passwordVaultEntries PasswordVaultEntry[]
  disposalItems        DisposalItem[]
  custodyTerms         CustodyTermAsset[]
  maintenanceRecords   MaintenanceRecord[]
  tickets              Ticket[]
  networkSegment       NetworkSegment?                    @relation(fields: [networkSegmentId], references: [id], onDelete: SetNull)
  licenseHistory       SoftwareLicenseAssignmentHistory[]

  @@unique([networkSegmentId, ipAddress])
  @@index([status])
  @@index([nextMaintenanceAt])
  @@index([lastFormattedAt])
  @@index([category])
  @@index([assignedToId])
  @@index([parentAssetId])
  @@index([companyId])
  @@index([purchasedByCompanyId])
  @@index([supplierId])
  @@index([networkSegmentId])
  @@map("assets")
}

model DisposalItem {
  id            String   @id @default(uuid())
  assetId       String?  @map("asset_id")
  accessoryId   String?  @map("accessory_id")
  itemName      String   @map("item_name")
  category      String?
  assetTag      String?  @map("asset_tag")
  serialNumber  String?  @map("serial_number")
  quantity      Int      @default(1)
  reason        String?
  destination   String?
  disposalDate  DateTime @default(now()) @map("disposal_date") @db.Date
  notes         String?  @db.Text
  performedById String   @map("performed_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  asset       Asset?     @relation(fields: [assetId], references: [id], onDelete: SetNull)
  accessory   Accessory? @relation(fields: [accessoryId], references: [id], onDelete: SetNull)
  performedBy User       @relation("DisposalPerformer", fields: [performedById], references: [id])

  @@index([assetId])
  @@index([accessoryId])
  @@index([performedById])
  @@index([disposalDate])
  @@map("disposal_items")
}

model SoftwareLicense {
  id             String    @id @default(uuid())
  softwareName   String    @map("software_name")
  version        String?
  ownerCompanyId String?   @map("owner_company_id")
  invoiceNumber  String?   @map("invoice_number")
  licenseNumber  String    @unique @map("license_number")
  supplierId     String?   @map("supplier_id")
  purchasedFrom  String?   @map("purchased_from")
  purchaseDate   DateTime? @map("purchase_date") @db.Date
  seats          Int       @default(1)
  isPerpetual    Boolean   @default(false) @map("is_perpetual")
  expiresAt      DateTime? @map("expires_at") @db.Date
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  ownerCompany      Company?                           @relation(fields: [ownerCompanyId], references: [id])
  supplier          Supplier?                          @relation(fields: [supplierId], references: [id])
  assets            SoftwareLicenseAsset[]
  assignmentHistory SoftwareLicenseAssignmentHistory[]

  @@index([softwareName])
  @@index([ownerCompanyId])
  @@index([supplierId])
  @@map("software_licenses")
}

model SoftwareLicenseAsset {
  id        String   @id @default(uuid())
  licenseId String   @map("license_id")
  assetId   String   @map("asset_id")
  createdAt DateTime @default(now()) @map("created_at")

  license SoftwareLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  asset   Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([licenseId, assetId])
  @@index([assetId])
  @@map("software_license_assets")
}

enum SoftwareLicenseAssignmentAction {
  ASSIGNED
  UNASSIGNED
  DETECTED
}

model SoftwareLicenseAssignmentHistory {
  id            String                          @id @default(uuid())
  licenseId     String                          @map("license_id")
  assetId       String                          @map("asset_id")
  action        SoftwareLicenseAssignmentAction
  source        String                          @default("MANUAL")
  performedById String?                         @map("performed_by_id")
  createdAt     DateTime                        @default(now()) @map("created_at")

  license     SoftwareLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  asset       Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  performedBy User?           @relation("LicenseHistoryPerformer", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([licenseId, createdAt])
  @@index([assetId, createdAt])
  @@map("software_license_assignment_history")
}

model NetworkSegment {
  id        String   @id @default(uuid())
  name      String
  cidr      String
  gateway   String?
  vlan      Int?
  location  String?
  companyId String?  @map("company_id")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company     Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ipAddresses NetworkIpAddress[]
  assets      Asset[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([active])
  @@map("network_segments")
}

enum IpAddressSource {
  MANUAL
  ASSET
  DISCOVERY
}

model NetworkIpAddress {
  id               String          @id @default(uuid())
  ipAddress        String          @map("ip_address")
  networkSegmentId String?         @map("network_segment_id")
  hostname         String?
  macAddress       String?         @map("mac_address")
  description      String?
  source           IpAddressSource @default(MANUAL)
  companyId        String?         @map("company_id")
  assetId          String?         @map("asset_id")
  lastSeenAt       DateTime?       @map("last_seen_at")
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  passwordVaultEntries PasswordVaultEntry[]
  networkSegment       NetworkSegment?      @relation(fields: [networkSegmentId], references: [id], onDelete: SetNull)

  @@unique([networkSegmentId, ipAddress])
  @@index([source])
  @@index([active])
  @@index([companyId])
  @@index([assetId])
  @@index([networkSegmentId])
  @@map("network_ip_addresses")
}

model DiscoveryIgnoredIp {
  id          String              @id @default(uuid())
  ipAddress   String              @map("ip_address")
  mode        DiscoveryIgnoreMode
  reason      String?
  createdById String              @map("created_by_id")
  createdAt   DateTime            @default(now()) @map("created_at")

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([ipAddress, mode])
  @@index([mode])
  @@index([createdById])
  @@map("discovery_ignored_ips")
}

enum PasswordVaultDeviceType {
  DVR
  NVR
  ROUTER
  ANTENNA
  ACCESS_POINT
  SWITCH
  CAMERA
  PRINTER
  SERVER
  OTHER
}

enum PasswordVaultEntryType {
  SOFTWARE
  USER
  NETWORK_DEVICE
  OTHER
}

model PasswordVaultEntry {
  id                        String                  @id @default(uuid())
  name                      String
  entryType                 PasswordVaultEntryType  @default(OTHER) @map("entry_type")
  deviceType                PasswordVaultDeviceType @default(OTHER) @map("device_type")
  ipAddressId               String?                 @map("ip_address_id")
  assetId                   String?                 @map("asset_id")
  host                      String?
  url                       String?
  port                      Int?
  protocol                  String?
  username                  String?
  passwordEncrypted         String?                 @map("password_encrypted") @db.Text
  adminUsername             String?                 @map("admin_username")
  adminPasswordEncrypted    String?                 @map("admin_password_encrypted") @db.Text
  userUsername              String?                 @map("user_username")
  userPasswordEncrypted     String?                 @map("user_password_encrypted") @db.Text
  internetUsername          String?                 @map("internet_username")
  internetPasswordEncrypted String?                 @map("internet_password_encrypted") @db.Text
  p12Username               String?                 @map("p12_username")
  p12PasswordEncrypted      String?                 @map("p12_password_encrypted") @db.Text
  emailUsername             String?                 @map("email_username")
  emailPasswordEncrypted    String?                 @map("email_password_encrypted") @db.Text
  notes                     String?                 @db.Text
  active                    Boolean                 @default(true)
  createdById               String?                 @map("created_by_id")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")

  ipAddress NetworkIpAddress? @relation(fields: [ipAddressId], references: [id], onDelete: SetNull)
  asset     Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdBy User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([deviceType])
  @@index([entryType])
  @@index([ipAddressId])
  @@index([assetId])
  @@index([active])
  @@map("password_vault_entries")
}

model AssetHistory {
  id            String             @id @default(uuid())
  assetId       String             @map("asset_id")
  action        AssetHistoryAction
  description   String
  performedById String             @map("performed_by_id")
  createdAt     DateTime           @default(now()) @map("created_at")

  asset       Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  performedBy User  @relation(fields: [performedById], references: [id])

  @@index([assetId])
  @@map("asset_history")
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String
  resourceType  String   @map("resource_type")
  resourceId    String?  @map("resource_id")
  resourceName  String   @map("resource_name")
  changedFields String[] @default([]) @map("changed_fields")
  details       Json?
  performedById String?  @map("performed_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  performedBy User? @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@map("audit_logs")
}

model Accessory {
  id                       String                  @id @default(uuid())
  name                     String
  category                 String
  quantity                 Int                     @default(0)
  minQuantity              Int                     @default(0) @map("min_quantity")
  unit                     String                  @default("un")
  condition                String                  @default("NEW")
  imageUrl                 String?                 @map("image_url")
  serialNumber             String?                 @map("serial_number")
  partNumber               String?                 @map("part_number")
  bandFrequency            String?                 @map("band_frequency")
  manufacturer             String?
  model                    String?
  location                 String?
  companyId                String?                 @map("company_id")
  purchasedByCompanyId     String?                 @map("purchased_by_company_id")
  supplierId               String?                 @map("supplier_id")
  purchaseSupplier         String?                 @map("purchase_supplier")
  purchaseInvoiceNumber    String?                 @map("purchase_invoice_number")
  purchaseInvoiceAccessKey String?                 @map("purchase_invoice_access_key")
  purchaseDate             DateTime?               @map("purchase_date") @db.Date
  warrantyExpires          DateTime?               @map("warranty_expires") @db.Date
  purchaseCost             Decimal?                @map("purchase_cost") @db.Decimal(12, 2)
  notes                    String?                 @db.Text
  active                   Boolean                 @default(true)
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")
  company                  Company?                @relation("AccessoryCompany", fields: [companyId], references: [id])
  purchasedByCompany       Company?                @relation("AccessoryPurchasedByCompany", fields: [purchasedByCompanyId], references: [id])
  supplier                 Supplier?               @relation(fields: [supplierId], references: [id])
  movements                AccessoryMovement[]
  disposalItems            DisposalItem[]
  purchaseRequests         PurchaseRequest[]
  balances                 AccessoryStockBalance[]
  maintenanceParts         MaintenancePart[]

  @@index([category])
  @@index([active])
  @@index([companyId])
  @@index([purchasedByCompanyId])
  @@index([supplierId])
  @@map("accessories")
}

model AccessoryStockBalance {
  id          String   @id @default(uuid())
  accessoryId String   @map("accessory_id")
  companyId   String?  @map("company_id")
  location    String?
  scopeKey    String   @map("scope_key")
  quantity    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  accessory Accessory           @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  company   Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  movements AccessoryMovement[]

  @@unique([accessoryId, scopeKey])
  @@index([companyId])
  @@map("accessory_stock_balances")
}

model AccessoryMovement {
  id                 String                @id @default(uuid())
  accessoryId        String                @map("accessory_id")
  type               AccessoryMovementType
  quantity           Int
  reason             String?
  assetId            String?               @map("asset_id")
  userId             String?               @map("user_id")
  performedById      String                @map("performed_by_id")
  canceledAt         DateTime?             @map("canceled_at")
  balanceId          String?               @map("balance_id")
  canceledById       String?               @map("canceled_by_id")
  cancellationReason String?               @map("cancellation_reason")
  createdAt          DateTime              @default(now()) @map("created_at")

  accessory       Accessory              @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  asset           Asset?                 @relation(fields: [assetId], references: [id])
  user            User?                  @relation("AccessoryMovementUser", fields: [userId], references: [id])
  performedBy     User                   @relation("AccessoryMovementPerformer", fields: [performedById], references: [id])
  canceledBy      User?                  @relation("AccessoryMovementCanceller", fields: [canceledById], references: [id])
  maintenancePart MaintenancePart?
  balance         AccessoryStockBalance? @relation(fields: [balanceId], references: [id], onDelete: SetNull)

  @@index([accessoryId])
  @@index([assetId])
  @@index([userId])
  @@index([performedById])
  @@index([canceledById])
  @@index([canceledAt])
  @@index([createdAt])
  @@index([balanceId])
  @@map("accessory_movements")
}

model Ticket {
  id              String         @id @default(uuid())
  title           String
  description     String         @db.Text
  category        TicketCategory
  status          TicketStatus   @default(OPEN)
  priority        Int            @default(1) // 1=Baixa, 2=Média, 3=Alta, 4=Urgente
  computerUser    String?        @map("computer_user")
  deviceHostname  String?        @map("device_hostname")
  deviceIp        String?        @map("device_ip")
  sourceAgentId   String?        @map("source_agent_id")
  assetId         String?        @map("asset_id")
  dueAt           DateTime?      @map("due_at")
  firstResponseAt DateTime?      @map("first_response_at")
  resolvedAt      DateTime?      @map("resolved_at")
  closedAt        DateTime?      @map("closed_at")
  attachments     String[]       @default([])
  createdById     String         @map("created_by_id")
  assignedToId    String?        @map("assigned_to_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relações
  createdBy         User               @relation("TicketCreator", fields: [createdById], references: [id])
  assignedTo        User?              @relation("TicketAssignee", fields: [assignedToId], references: [id])
  comments          Comment[]
  history           TicketHistory[]
  feedback          Feedback?
  knowledgeArticles KnowledgeArticle[]
  asset             Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([createdById])
  @@index([assignedToId])
  @@index([deviceHostname])
  @@index([assetId])
  @@index([dueAt])
  @@map("tickets")
}

model Comment {
  id        String   @id @default(uuid())
  message   String   @db.Text
  ticketId  String   @map("ticket_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relações
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@map("comments")
}

model TicketHistory {
  id          String       @id @default(uuid())
  ticketId    String       @map("ticket_id")
  oldStatus   TicketStatus @map("old_status")
  newStatus   TicketStatus @map("new_status")
  changedById String       @map("changed_by_id")
  changedAt   DateTime     @default(now()) @map("changed_at")

  // Relações
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy User   @relation(fields: [changedById], references: [id])

  @@index([ticketId])
  @@map("ticket_history")
}

model CustodyTerm {
  id                String            @id @default(uuid())
  number            String            @unique
  type              CustodyTermType
  status            CustodyTermStatus @default(DRAFT)
  responsibleUserId String            @map("responsible_user_id")
  createdById       String            @map("created_by_id")
  accessoryItems    Json              @default("[]") @map("accessory_items")
  notes             String?           @db.Text
  signedByName      String?           @map("signed_by_name")
  signedAt          DateTime?         @map("signed_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  responsibleUser User               @relation("CustodyTermResponsible", fields: [responsibleUserId], references: [id])
  createdBy       User               @relation("CustodyTermCreator", fields: [createdById], references: [id])
  assets          CustodyTermAsset[]

  @@index([responsibleUserId])
  @@index([status])
  @@index([createdAt])
  @@map("custody_terms")
}

model CustodyTermAsset {
  id            String @id @default(uuid())
  custodyTermId String @map("custody_term_id")
  assetId       String @map("asset_id")

  custodyTerm CustodyTerm @relation(fields: [custodyTermId], references: [id], onDelete: Cascade)
  asset       Asset       @relation(fields: [assetId], references: [id])

  @@unique([custodyTermId, assetId])
  @@index([assetId])
  @@map("custody_term_assets")
}

model MaintenanceRecord {
  id                String                  @id @default(uuid())
  assetId           String                  @map("asset_id")
  status            MaintenanceRecordStatus @default(PLANNED)
  scheduledAt       DateTime                @map("scheduled_at") @db.Date
  completedAt       DateTime?               @map("completed_at")
  checklist         Json                    @default("[]")
  workPerformed     String?                 @map("work_performed") @db.Text
  partsUsed         String?                 @map("parts_used") @db.Text
  cost              Decimal?                @db.Decimal(12, 2)
  nextMaintenanceAt DateTime?               @map("next_maintenance_at") @db.Date
  createdById       String                  @map("created_by_id")
  completedById     String?                 @map("completed_by_id")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  asset       Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("MaintenanceCreator", fields: [createdById], references: [id])
  completedBy User?             @relation("MaintenanceCompleter", fields: [completedById], references: [id])
  parts       MaintenancePart[]

  @@index([assetId])
  @@index([status])
  @@index([scheduledAt])
  @@map("maintenance_records")
}

model MaintenancePart {
  id            String   @id @default(uuid())
  maintenanceId String   @map("maintenance_id")
  accessoryId   String   @map("accessory_id")
  movementId    String?  @unique @map("movement_id")
  quantity      Int
  createdAt     DateTime @default(now()) @map("created_at")

  maintenance MaintenanceRecord  @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  accessory   Accessory          @relation(fields: [accessoryId], references: [id])
  movement    AccessoryMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)

  @@unique([maintenanceId, accessoryId])
  @@index([accessoryId])
  @@map("maintenance_parts")
}

model KnowledgeArticle {
  id          String   @id @default(uuid())
  title       String
  category    String
  problem     String   @db.Text
  solution    String   @db.Text
  tags        String[] @default([])
  ticketId    String?  @map("ticket_id")
  published   Boolean  @default(true)
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ticket    Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([category])
  @@index([published])
  @@index([ticketId])
  @@map("knowledge_articles")
}

model PurchaseRequest {
  id                String                @id @default(uuid())
  accessoryId       String?               @map("accessory_id")
  supplierId        String?               @map("supplier_id")
  itemName          String                @map("item_name")
  requestedQuantity Int                   @map("requested_quantity")
  unit              String                @default("un")
  status            PurchaseRequestStatus @default(REQUESTED)
  estimatedUnitCost Decimal?              @map("estimated_unit_cost") @db.Decimal(12, 2)
  notes             String?               @db.Text
  requestedById     String                @map("requested_by_id")
  receivedAt        DateTime?             @map("received_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  accessory   Accessory? @relation(fields: [accessoryId], references: [id], onDelete: SetNull)
  supplier    Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  requestedBy User       @relation(fields: [requestedById], references: [id])

  @@index([status])
  @@index([accessoryId])
  @@index([supplierId])
  @@index([createdAt])
  @@map("purchase_requests")
}

enum IntegrationType {
  SLACK
  TEAMS
  WHATSAPP
}

enum FeedbackRating {
  VERY_POOR
  POOR
  AVERAGE
  GOOD
  EXCELLENT
}

model Integration {
  id         String          @id @default(uuid())
  type       IntegrationType
  name       String
  webhookUrl String?         @map("webhook_url")
  apiKey     String?         @map("api_key")
  active     Boolean         @default(true)
  config     Json? // Configurações específicas de cada integração
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@map("integrations")
}

model Feedback {
  id        String         @id @default(uuid())
  ticketId  String         @unique @map("ticket_id")
  userId    String         @map("user_id")
  rating    FeedbackRating
  npsScore  Int?           @map("nps_score") // 0-10
  comment   String?        @db.Text
  createdAt DateTime       @default(now()) @map("created_at")

  // Relações
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([rating])
  @@map("feedbacks")
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  userId    String?  @map("user_id")
  message   String   @db.Text
  isBot     Boolean  @default(false) @map("is_bot")
  metadata  Json? // Armazena sugestões, análises, etc
  createdAt DateTime @default(now()) @map("created_at")

  // Relações
  user User? @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@index([userId])
  @@map("chat_messages")
}
